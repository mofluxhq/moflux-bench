# OS and editor files
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# Node diagnostics and local state
node_modules/
npm-debug.log*
*.log
.env
.env.*
!.env.example

# Generated benchmark output. Reviewed evidence is explicitly unignored.
#
# Every sweep writes to results/runs/<sweep>/<run-id>/ and nothing else. That
# tree stays ignored; reviewed evidence below changes only through
# demo/publish-evidence.mjs.
results/*
results/runs/
!results/README.md
!results/curated/
!results/curated/**
# Reviewed five-seed heterogeneous sweep published at v0.10.0. Each per-seed
# file records the runtime that produced it in its own `runtime` field; as
# published those read Tyr 0.17.0 / Latchflo 0.5.1.
!results/video-seed-sweep.json
!results/video-seed-sweep/
!results/video-seed-sweep/**
!results/replicates/
results/replicates/*
!results/replicates/.gitkeep

# Coverage and temporary files
coverage/
.tmp/
tmp/

# Local proprietary-image configuration
demo/moflux/.env

# Ephemeral TLS material generated for the tenant-fairness demo.
demo/classes/runtime/

!results/openai-live-compatibility.json
!results/openai-live-compatibility/
!results/openai-live-compatibility/**
