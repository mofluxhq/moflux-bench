{
  "uid": "moflux-bench",
  "title": "MoFlux benchmark harness",
  "description": "Video-ready benchmark dashboard for the public arms and licensed Tyr + Latchflo runs.",
  "tags": [
    "moflux-bench"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "phases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "moflux-bench"
          ],
          "limit": 100
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Interactive p99 latency",
      "description": "Client-observed rolling p99 latency. The telemetry relay retains each arm after its load-generator process exits.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "bench_latency_p99_ms{class=\"interactive\"}",
          "legendFormat": "{{arm}} / seed {{seed}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Interactive p99 time-to-first-token",
      "description": "Client-observed rolling p99 time to first token. It is pushed independently of the ephemeral load-generator process.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "bench_ttft_p99_ms{class=\"interactive\"}",
          "legendFormat": "{{arm}} / seed {{seed}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retry amplification",
      "description": "Attempts per logical request. 1.0 is no retries. This is how a provider rejection turns into more load on the thing that just rejected you.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "bench_retry_amplification",
          "legendFormat": "{{arm}} / {{class}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rejections: cheap vs expensive",
      "description": "The entire pitch, quantified. A local reject costs nothing. An upstream 429 was earned only after provider capacity had already been spent.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum by (arm) (rate(bench_local_rejects_total[15s]))",
          "legendFormat": "{{arm}} local (cheap)",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum by (arm) (rate(bench_upstream_rejects_total[15s]))",
          "legendFormat": "{{arm}} upstream 429 (expensive)",
          "refId": "B",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Delivered token goodput",
      "description": "Output tokens actually reaching callers. Goodput, not throughput: work that was abandoned or retried away does not count.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum by (arm) (rate(bench_output_tokens_total[15s]))",
          "legendFormat": "{{arm}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Provider envelope occupancy",
      "description": "Ground truth from the simulator. Above the envelope line is impossible; persistently below it while callers are being refused means capacity is being stranded.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sim_active",
          "legendFormat": "in flight",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sim_queued",
          "legendFormat": "queued at provider",
          "refId": "B",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sim_envelope",
          "legendFormat": "envelope",
          "refId": "C",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Per-stream token rate (the contention curve, live)",
      "description": "The mechanism the whole benchmark rests on: as concurrency rises, each stream gets slower. This is the curve being swept, observed in real time.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sim_per_stream_tokens_per_second",
          "legendFormat": "per-stream tok/s",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sim_aggregate_tokens_per_second",
          "legendFormat": "aggregate tok/s",
          "refId": "B",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "In-flight per replica",
      "description": "Fleet balance for both public benchmark replicas and Tyr. Latchflo-managed Tyr instances expose native in-flight state.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "replica_in_flight",
          "legendFormat": "{{arm}} {{replica}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "tyr_pool_in_flight",
          "legendFormat": "Tyr {{instance}}",
          "refId": "B",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Admission decision overhead",
      "description": "What the coordination costs on the request path. Arms 1-3 decide locally and pay nothing here; the Redis arm pays a round trip per admission.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "replica_admission_overhead_ms_avg > 0",
          "legendFormat": "{{arm}} {{replica}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Generator saturated",
      "description": "Must be zero. Any non-zero value means the load generator was the bottleneck and the run is invalid.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(generator_saturated_total)",
          "legendFormat": "dropped arrivals",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tyr in-flight token capacity",
      "description": "The live token reservation held across the Tyr fleet. This is concurrent capacity, not provider TPM.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "tyr_pool_tokens_in_flight",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tyr token reconciliation",
      "description": "Cumulative reservations, consumption, total refunds, early progressive release, and overruns reported by Tyr.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(tyr_pool_tokens_reserved_total)",
          "legendFormat": "reserved",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(tyr_pool_tokens_consumed_total)",
          "legendFormat": "consumed",
          "refId": "B",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(tyr_pool_tokens_refunded_total)",
          "legendFormat": "refunded",
          "refId": "C",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(tyr_pool_tokens_overrun_total)",
          "legendFormat": "overrun",
          "refId": "D",
          "interval": "",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "sum(tyr_pool_progressive_tokens_released_total)",
          "legendFormat": "released before completion",
          "refId": "E",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Recovered reserved capacity",
      "description": "Unused token reservation returned during the visible dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "100 * sum(increase(tyr_pool_tokens_refunded_total[$__range])) / clamp_min(sum(increase(tyr_pool_tokens_reserved_total[$__range])), 1)",
          "legendFormat": "gross recovery",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Net recovered capacity",
      "description": "Refunded reservation minus overruns, divided by total reservation during the visible time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "bench-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bench-prom"
          },
          "expr": "100 * (sum(increase(tyr_pool_tokens_refunded_total[$__range])) - sum(increase(tyr_pool_tokens_overrun_total[$__range]))) / clamp_min(sum(increase(tyr_pool_tokens_reserved_total[$__range])), 1)",
          "legendFormat": "net recovery",
          "refId": "A",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Latchflo grant revisions",
      "description": "Odd revisions are active grants. Tyr reserves the following even revision for its local expiration kill switch.",
      "datasource": {
        "type": "prometheus",
