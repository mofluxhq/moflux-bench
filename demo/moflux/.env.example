# `npm run demo` creates demo/moflux/.env automatically on first use with
# random local-only tokens and these pinned image tags. Copy this file only if
# you want to configure a licensed registry path before the first run.
MOFLUX_TYR_IMAGE=tyr-admission-controller:0.33.0
MOFLUX_LATCHFLO_IMAGE=latchflo-control-plane:0.19.0

# Local inference benchmark (npm run demo:local). Unlicensed and unmetered:
# this image is public and the weights are pulled once into a named volume.
MOFLUX_OLLAMA_IMAGE=ollama/ollama:0.12.3
MOFLUX_LOCAL_MODEL=qwen3:0.6b

# GPU-backed vLLM contention benchmark. The image is version-pinned; model
# weights are cached in an external Docker volume and are never committed.
MOFLUX_VLLM_IMAGE=vllm/vllm-openai:v0.18.0
MOFLUX_VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MOFLUX_VLLM_SERVED_MODEL=moflux-vllm
# The runner resolves this symbolic revision to an immutable commit before it
# starts the first arm, then supplies that commit to every vLLM container.
MOFLUX_VLLM_MODEL_REVISION=main
# Optional: export HF_TOKEN in the invoking shell for authenticated model
# downloads. HUGGING_FACE_HUB_TOKEN is accepted as a legacy alias. Do not put a
# real Hub token in this checked-in example or commit it in demo/moflux/.env.

# Optional local source builds. Paths are resolved from the moflux-bench root.
# When these are omitted, npm run demo auto-detects matching sibling folders.
# MOFLUX_TYR_SOURCE_DIR=../tyr-admission-controller
# MOFLUX_LATCHFLO_SOURCE_DIR=../latchflo-control-plane

# Explicit placeholders are intentional. Never commit the generated .env.
LATCHFLO_ADMIN_TOKEN=replace-with-local-admin-token
LATCHFLO_AGENT_BOOTSTRAP_TOKEN=replace-with-local-bootstrap-token
TYR_ROUTING_SECRET=replace-with-one-shared-random-routing-secret

# Local video-demo convenience for fresh root-owned named volumes.
# Override with the image runtime UID:GID for a production-like run.
MOFLUX_TYR_USER=0:0
